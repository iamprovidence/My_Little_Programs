@model PaymentDetailsViewModel

<h1>Payment Details</h1>

<input type="radio" asp-for="PaymentMethod" value="@PaymentMethod.Cash" />Cash
<br />
<input type="radio" asp-for="PaymentMethod" value="@PaymentMethod.CreditCard" />CreditCard
<br />
<br />

@if (Model.FlowContext.CanGoBack)
{
	<button onclick="submitCommand('@nameof(GoBackCommand)');">Back</button>
}
<button onclick="submitCommand('@nameof(SubmitPaymentDetailsCommand)');">Complete</button>